rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Day 3: User Profile Security Rules
    // Customers can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Day 8: Customer Orders Security Rules
    // Customers can only create orders where userId matches their authenticated UID,
    // and can only read/listen to/update orders they own.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
